# ---- Coco Automation configuration (copy to .env; install.sh does this for you) ----
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080

# PostgreSQL connection (install.sh creates user/db and fills the password)
DATABASE_URL=postgresql+psycopg://coco:CHANGE_ME@localhost:5432/coco

# Fernet key for encrypting YouTube OAuth tokens. NEVER commit / lose this key:
# without it stored tokens cannot be decrypted (channels must reconnect).
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SECRET_KEY=

# Dashboard login (HTTP Basic). Leave password empty to disable (NOT recommended on shared LAN)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Storage for images / audio / rendered videos. Use a large local disk.
# STORAGE_DIR=/data/coco/storage
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# ---- YouTube (Phase 3) -------------------------------------------------------
# OAuth client from YOUR Google Cloud project (see docs/YOUTUBE_SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud. Use http://localhost:<PORT>/... when
# you open the dashboard on the same machine; for LAN access see docs/YOUTUBE_SETUP.md.
OAUTH_REDIRECT_URI=http://localhost:8080/api/youtube/oauth/callback
# YOUTUBE_UPLOAD_CHUNK_MB=8

# ---- Analytics (Phase 4) -----------------------------------------------------
# Automatic YouTube metrics sync per connected channel (the "Sync now" button works any time).
# ANALYTICS_SYNC_INTERVAL_MINUTES=360
# First sync looks back this many days; later syncs re-read the last ANALYTICS_OVERLAP_DAYS days.
# ANALYTICS_INITIAL_DAYS=90
# ANALYTICS_OVERLAP_DAYS=7

# ---- Monitoring & recovery (Phase 5) -----------------------------------------
# The render worker waits (instead of starting a job) when free RAM drops below this.
# MIN_FREE_RAM_MB=700
# RAM_WARN_PERCENT=90
# DISK_WARN_GB=15
# Watchdog: an upload with no progress for this long is considered hung and its worker is restarted
# PUBLISH_STALL_SECONDS=600
# LOG_RETENTION_DAYS=90
# METRICS_RETENTION_DAYS=7

# ---- Windows / portable install (written by scripts\windows\install.ps1) ------
# EMBEDDED_PG=true   -> Coco runs its own private PostgreSQL on 127.0.0.1 (data\pgdata); see docs/WINDOWS.md
# FFMPEG_PATH=       -> empty = ffmpeg on PATH; the installer fills the bundled ffmpeg when none is found

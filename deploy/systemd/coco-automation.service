# Installed by scripts/install.sh --systemd (placeholders replaced automatically)
[Unit]
Description=Coco Automation - multi-channel YouTube platform
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/scripts/run.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
KillSignal=SIGTERM
# One unit runs API + render worker + publish worker (scripts/run.sh). 8 GB machine guard:
MemoryMax=6G
Nice=5
StandardOutput=append:__APP_DIR__/logs/server.out
StandardError=append:__APP_DIR__/logs/server.out

[Install]
WantedBy=multi-user.target
